{{- /* /feed.json — JSON Feed 1.1 with full HTML and plain-text content for every post. */ -}}
{{- $avatar := "" }}{{ with resources.Get site.Params.Author.image }}{{ $avatar = .Permalink }}{{ end -}}
{{- $author := dict "name" site.Params.Author.name "url" site.BaseURL "avatar" $avatar -}}
{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $md := "" }}{{ with .OutputFormats.Get "markdown" }}{{ $md = .Permalink }}{{ end -}}
  {{- $js := "" }}{{ with .OutputFormats.Get "json" }}{{ $js = .Permalink }}{{ end -}}
  {{- $html := replaceRE `(src|href)="/([^/"])` (printf `${1}="%s${2}` site.BaseURL) .Content -}}
  {{- $items = $items | append (dict
    "id" .Permalink
    "url" .Permalink
    "title" (.Title | plainify)
    "summary" (.Description | default (.Summary | plainify | htmlUnescape))
    "content_html" $html
    "content_text" (.Plain | htmlUnescape)
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
    "language" site.Language.Lang
    "tags" (.Params.tags | default slice)
    "authors" (slice $author)
    "_hayorov" (dict "markdown_url" $md "json_url" $js "word_count" .WordCount "reading_time_minutes" .ReadingTime)
  ) -}}
{{- end -}}
{{- dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" site.Title
  "home_page_url" site.BaseURL
  "feed_url" ("feed.json" | absURL)
  "description" site.Params.description
  "icon" $avatar
  "favicon" ("favicon.ico" | absURL)
  "language" site.Language.Lang
  "authors" (slice $author)
  "items" $items
  | jsonify (dict "indent" "  " "noHTMLEscape" true) -}}
