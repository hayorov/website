{{- /* Structured JSON index of a section (e.g. /posts/index.json): metadata per entry, full content via each entry's json_url. */ -}}
{{- $items := slice -}}
{{- range .RegularPages -}}
  {{- $md := "" }}{{ with .OutputFormats.Get "markdown" }}{{ $md = .Permalink }}{{ end -}}
  {{- $js := "" }}{{ with .OutputFormats.Get "json" }}{{ $js = .Permalink }}{{ end -}}
  {{- $i := dict
    "title" (.Title | plainify)
    "description" .Description
    "url" .Permalink
    "markdown_url" $md
    "json_url" $js
    "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "lastmod" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
    "tags" (.Params.tags | default slice)
    "word_count" .WordCount
    "reading_time_minutes" .ReadingTime
  -}}
  {{- $items = $items | append $i -}}
{{- end -}}
{{- $md := "" }}{{ with .OutputFormats.Get "markdown" }}{{ $md = .Permalink }}{{ end -}}
{{- dict
  "title" (.Title | plainify)
  "description" .Description
  "url" .Permalink
  "markdown_url" $md
  "type" "section"
  "language" site.Language.Lang
  "count" (len $items)
  "items" $items
  | jsonify (dict "indent" "  " "noHTMLEscape" true) -}}
